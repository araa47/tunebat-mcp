{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp@latest"]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        },
        "tunebat-mcp": {
            "command": "uv",
            "args": [
                "run",
                "--refresh-package",
                "tunebat-mcp",
                "--with",
                ".",
                "tunebat-mcp"
            ],
            "cwd": "."
        }
    }
}
